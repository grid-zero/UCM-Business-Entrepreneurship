---
layout: layouts/page.njk
title: Contact
eyebrow: Contact
lead: Questions, ideas, or partnership proposals. We would be glad to hear from you.
permalink: /contact/
---
<section class="section">
  <div class="container contact-grid">
    <div class="contact-card contact-card--primary">
      <p class="eyebrow">Email</p>
      <h2>Get in touch</h2>
      <p>The best way to reach the board is by email. We aim to reply within a few working days.</p>
      <a class="contact-email" href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a class="button button--primary" href="mailto:{{ site.email }}">Send us an email</a>
    </div>

    <div class="contact-card">
      <p class="eyebrow eyebrow--dark">Where to find us</p>
      <address class="contact-address">
        {%- for line in site.address %}{{ line }}<br>{% endfor -%}
      </address>
      {% if site.linkedin or site.instagram %}
      <p class="eyebrow eyebrow--dark contact-social-label">Follow us</p>
      <ul class="contact-social">
        {% if site.linkedin %}<li><a class="text-link" href="{{ site.linkedin }}" rel="noopener">LinkedIn <span aria-hidden="true">&rarr;</span></a></li>{% endif %}
        {% if site.instagram %}<li><a class="text-link" href="{{ site.instagram }}" rel="noopener">Instagram <span aria-hidden="true">&rarr;</span></a></li>{% endif %}
      </ul>
      {% endif %}
    </div>
  </div>
</section>

<section class="section section--alt" id="faq">
  <div class="container split split--wide">
    <div>
      <p class="eyebrow eyebrow--dark">FAQ</p>
      <h2>Frequently Asked Questions</h2>
      <p class="lead-muted">Can't find your answer? <a href="mailto:{{ site.email }}">Email us</a>.</p>
    </div>
    <div class="faq">
      {% for item in faq.items %}
      <details class="faq-item"{% if loop.first %} open{% endif %}>
        <summary>{{ item.question }}</summary>
        <div class="faq-answer">{{ item.answer | markdown | safe }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
